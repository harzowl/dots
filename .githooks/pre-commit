#!/usr/bin/env bash
# Format staged Nix files with the flake's formatter and re-stage them, then run
# the repeated-attribute-path checker over them. The checker is
# `scripts/check-nest.sh` (see AGENTS.md); it exits 2 when awk is missing, which
# fails the commit loudly rather than skipping the check.
set -euo pipefail

files=$(git diff --cached --name-only --diff-filter=ACM -- '*.nix')
[ -z "$files" ] && exit 0

# shellcheck disable=SC2086
nix fmt -- $files
# shellcheck disable=SC2086
git add -- $files

# shellcheck disable=SC2086
scripts/check-nest.sh $files
