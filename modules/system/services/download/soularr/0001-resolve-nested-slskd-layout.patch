+def normalize_match_text(value):
+    """Fold case, accents and punctuation so folder names compare reliably."""
+    decomposed = unicodedata.normalize("NFKD", value)
+    stripped = "".join(char for char in decomposed if not unicodedata.combining(char))
+    return " ".join(re.sub(r"[^0-9a-z]+", " ", stripped.casefold()).split())
+
+
+def contains_year(value, year):
+    if not year:
+        return False
+    return re.search(rf"(?<!\d){re.escape(str(year))}(?!\d)", value) is not None
+
+
+def transfer_source_dir(username, file_dir):
+    """Local directory that slskd writes a transfer's remote folder to.
+
+    slskd's `transfers.download.destination.subdirectory` puts transfers below
+    `<download_dir>/<username>/directories/<remote path>`, so a peer folder name
+    must never be joined to `download_dir` on its own: that collapses every
+    user's identically named album onto one path.
+    """
+    parts = [part for part in file_dir.replace("\\", "/").split("/") if part not in ("", ".")]
+    return os.path.join(slskd_download_dir, username, "directories", *parts)
+
+
+def _is_ancestor_or_equal(parent, child):
+    parent = os.path.normpath(parent)
+    child = os.path.normpath(child)
+    return child == parent or child.startswith(parent + os.sep)
+
+
+def resolve_album_dir(username, file_dir, title, year):
+    """Locate the album folder for a finished transfer under its user's tree.
+
+    Returns the year-matched folder when one exists. A title-only folder is
+    used only when no same-titled folder carries the year, and that fallback
+    is logged: picking it silently could hand Lidarr a different edition.
+    """
+    source_dir = transfer_source_dir(username, file_dir)
+    user_dirs = os.path.join(slskd_download_dir, username, "directories")
+    title_key = normalize_match_text(title)
+    if not title_key or not os.path.isdir(user_dirs):
+        return source_dir, False
+
+    candidates = []
+    for root, dirs, _files in os.walk(user_dirs):
+        for name in dirs:
+            if f" {title_key} " in f" {normalize_match_text(name)} ":
+                candidates.append((os.path.join(root, name), contains_year(name, year)))
+    if not candidates:
+        logger.warning(
+            "No album folder for %r below %s; falling back to the transfer path %s",
+            title,
+            user_dirs,
+            source_dir,
+        )
+        return source_dir, False
+
+    def rank(candidate):
+        folder, year_matched = candidate
+        shared_depth = len(os.path.commonpath([source_dir, folder]).split(os.sep))
+        return (
+            not year_matched,
+            not _is_ancestor_or_equal(folder, source_dir),
+            -shared_depth,
+            len(folder),
+        )
+
+    folder, year_matched = min(candidates, key=rank)
+    logger.info(
+        "Resolved album folder for %r (%s): %s%s",
+        title,
+        year,
+        folder,
+        "" if year_matched else " [title-only, year not found]",
+    )
+    if not year_matched:
+        logger.warning(
+            "No folder for %r carried year %s below %s; using title-only match %s",
+            title,
+            year,
+            user_dirs,
+            folder,
+        )
+    return folder, year_matched
+
+
+def downloaded_file_path(username, file_dir, filename, album_dir):
+    """Resolve one transfer's file, using its exact source path first."""
+    exact = os.path.join(transfer_source_dir(username, file_dir), filename)
+    if os.path.isfile(exact):
+        return exact
+    for root, _dirs, files in os.walk(album_dir):
+        if filename in files:
+            return os.path.join(root, filename)
+    return exact
+
